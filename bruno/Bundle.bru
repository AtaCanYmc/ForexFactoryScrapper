meta {
  name: Bundle
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/bundle?start_date=2024-05-01&end_date=2024-05-03&sources=forex,crypto&limit=10&offset=0
  body: none
  auth: none
}

params:query {
  start_date: 2024-05-01
  end_date: 2024-05-03
  sources: forex,crypto
  limit: 10
  offset: 0
}

assert {
  res.status: eq 200
}

tests {
  test("paging envelope", function () {
    expect(res.body.total).to.be.a("number");
    expect(res.body.results).to.be.an("array");
    expect(res.body.results.length).to.be.at.most(10);
  });
  test("echoes range and sources", function () {
    expect(res.body.start_date).to.equal("2024-05-01");
    expect(res.body.end_date).to.equal("2024-05-03");
    expect(res.body.sources).to.have.members(["forex", "crypto"]);
  });
  test("source breakdown present", function () {
    expect(res.body.source_breakdown).to.have.all.keys("forex", "crypto");
  });
}
