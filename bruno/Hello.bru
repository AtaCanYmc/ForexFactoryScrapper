meta {
  name: Hello
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/hello
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns success message", function () {
    expect(res.body.status).to.equal("success");
  });
  test("security headers set", function () {
    expect(res.headers["x-content-type-options"]).to.equal("nosniff");
    expect(res.headers["x-request-id"]).to.be.a("string");
  });
}
