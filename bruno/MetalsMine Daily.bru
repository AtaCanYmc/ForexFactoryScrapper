meta {
  name: MetalsMine Daily
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/metalsmine/daily?day=2&month=5&year=2024&limit=5&offset=0
  body: none
  auth: none
}

params:query {
  day: 2
  month: 5
  year: 2024
  limit: 5
  offset: 0
}

assert {
  res.status: eq 200
}

tests {
  test("paging envelope", function () {
    expect(res.body.total).to.be.a("number");
    expect(res.body.offset).to.equal(0);
    expect(res.body.limit).to.equal(5);
    expect(res.body.results).to.be.an("array");
  });
  test("respects limit", function () {
    expect(res.body.results.length).to.be.at.most(5);
  });
  test("security headers set", function () {
    expect(res.headers["x-content-type-options"]).to.equal("nosniff");
    expect(res.headers["x-request-id"]).to.be.a("string");
  });
}
