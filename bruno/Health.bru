meta {
  name: Health
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("status is ok", function () {
    expect(res.body.status).to.equal("ok");
  });
  test("no probe metrics by default", function () {
    expect(res.body).to.not.have.property("upstream");
  });
}
