meta {
  name: OpenAPI Spec
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/openapi.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("valid OpenAPI 3 document", function () {
    expect(res.body.openapi).to.match(/^3\./);
    expect(res.body.paths).to.have.property("/api/bundle");
  });
}
