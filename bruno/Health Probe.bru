meta {
  name: Health Probe
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/health?probe=true
  body: none
  auth: none
}

params:query {
  probe: true
}

assert {
  res.status: eq 200
}

tests {
  test("includes probe metrics", function () {
    expect(res.body.status).to.equal("ok");
    expect(res.body.upstream).to.have.property("latency_ms");
    expect(res.body.upstream.reachable).to.be.a("boolean");
    expect(res.body.memory_mb).to.be.above(0);
  });
}
