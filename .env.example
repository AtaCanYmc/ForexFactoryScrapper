# .env.example: copy to .env and adjust values as needed
# Host and port for Flask HTTP API
HOST=127.0.0.1
PORT=5000

# Debug mode: True or False (keep False in production)
DEBUG=False

# Allowed CORS origins (comma-separated, e.g. https://example.com,http://localhost:3000)
# Defaults to * if unset
CORS_ORIGINS=*

# Resource limits (Denial of Service prevention)
MAX_BUNDLE_DAYS=31
MAX_SITEMAP_PAGES=100

# Performance (0 disables)
CACHE_TTL_SECONDS=0
CACHE_MAX_ENTRIES=256
RATE_LIMIT_PER_MINUTE=0

# Logging: LOG_FORMAT=json for log aggregators, LOG_LEVEL=DEBUG|INFO|WARNING
LOG_FORMAT=text
LOG_LEVEL=INFO
# Trusted reverse-proxy hops (1 behind Caddy or an ingress controller, 0 if exposed directly)
TRUST_PROXY_HOPS=0

# Optional: custom path to an external .env file
# DOTENV_PATH=/path/to/.env
